    if ((screen->gpu_type == DRM_LIMA_PARAM_GPU_ID_MALI400) ||
-       (damage && damage->region) || !lima_damage_fullscreen(job))
+       (damage && damage->region) || !lima_damage_fullscreen(job) ||
